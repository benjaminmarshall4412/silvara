// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Marketing / promo email captures with regional site context.
model EmailSignup {
  id                    String    @id @default(cuid())
  email                 String    @unique @db.VarChar(320)
  region                String    @db.VarChar(8)
  pathname              String    @db.VarChar(1024)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  /// Set when the welcome (`silvara.promo_signup`) automation has been triggered once.
  promoAutomationSentAt DateTime?
  /// Set on first paid checkout — suppresses repeat post-purchase + browse/cart events.
  firstOrderAt          DateTime?

  @@index([createdAt])
  @@index([region])
  @@index([firstOrderAt])
}

/// Fulfillment flags for Stripe Checkout sessions (admin orders UI).
model OrderFulfillment {
  /// Stripe Checkout Session id (`cs_...`)
  sessionId String    @id @db.VarChar(255)
  region    String    @db.VarChar(8)
  packedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([packedAt])
  @@index([region])
}

/// Manual cost rows for the admin financials spreadsheet (ads, shipping, socks, …).
model FinanceEntry {
  id          String   @id @default(cuid())
  /// Calendar day the cost applies to (UTC date at midnight).
  date        DateTime @db.Date
  /// ads | shipping | socks | other
  category    String   @db.VarChar(32)
  amountCents Int
  currency    String   @default("usd") @db.VarChar(3)
  note        String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([category])
}
